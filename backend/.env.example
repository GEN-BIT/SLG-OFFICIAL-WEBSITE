# Backend configuration for SLG TSS

NODE_ENV=development
PORT=5500

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Admin credentials
# NOTE: Store only the hashed password in ADMIN_PASSWORD_HASH.
# You can generate one via: node scripts/hash-password.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$REPLACE_ME

# Data storage (dev-friendly)
DATA_DIR=./data

